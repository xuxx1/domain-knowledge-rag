# LLM 配置（OpenAI 兼容 API，填入你的服务商信息）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 本地 Embedding 模型（首次运行自动从 HuggingFace 下载到 models/ 目录）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ================= RAG 检索参数 =================
# 分块目标字符数：文档按此大小切块（越大每块信息越完整，但检索定位越粗）
CHUNK_SIZE=500
# 分块间重叠字符数：相邻块重叠，避免关键信息恰好被切断在边界
CHUNK_OVERLAP=80
# 向量召回数量：从向量库中取前 N 个候选片段（越大召回越全，但噪声越多）
RETRIEVAL_TOP_K=8
# 重排后保留数量：最终进入生成上下文的片段数（越大上下文越足、越耗token）
RERANK_TOP_K=4
# 相似度阈值：检索片段相似度低于此值直接丢弃（越低越容易命中、越易误检）
SCORE_THRESHOLD=0.35

# ================= 可回答性校验参数 =================
# 可回答性兜底阈值：命中片段最高相似度低于此值，即使 LLM 判定可回答也视为不可回答。
# 调低(如0.30)更容易给出答案但风险是回答不准确；调高(如0.60)更保守、易拒答。
ANSWERABLE_MIN_SCORE=0.50
# 英文文档库判定阈值：抽样文档分块中，中文字符占比低于该值即视为英文文档库。
# 此时中文提问会自动翻译成英文再检索（中文文档不受影响）。
EN_KB_CJK_RATIO=0.10
# 同一文档最多保留的片段数：单文档论文入库时需让含答案的片段进入生成；
# 调高(如6)有助于命中但增加token；多文档库可调低(如1-2)避免单文档刷屏。
RANK_DOC_LIMIT=4

# 服务
PORT=8000